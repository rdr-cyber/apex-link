# APEX LINK Backend Environment Configuration
# Copy to .env and update values.
# NEVER commit .env with real credentials.

# ── Application ───────────────────────────────────────────
APP_NAME=APEX LINK
APP_VERSION=0.1.0
DEBUG=false
PORT=8000

# ── Database ──────────────────────────────────────────────
# For Supabase: use the connection string from Settings → Database → URI
# For local Docker: use the default postgres values below
DATABASE_URL=postgresql+asyncpg://apex_user:apex_password@postgres:5432/apex_link
DATABASE_URL_SYNC=postgresql+psycopg2://apex_user:apex_password@postgres:5432/apex_link

# Connection pool (conservative for free-tier managed PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ── JWT ───────────────────────────────────────────────────
# Generate a production secret: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────
# Production: ONLY the actual frontend origin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Storage ──────────────────────────────────────────
# Production on Render: local files are ephemeral (lost on restart)
# For persistent storage, use S3 or Supabase Storage
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage/evidence

# ── AI (disabled by default) ──────────────────────────────
AI_PROVIDER=disabled

# ── Email Verification ────────────────────────────────────
# "console" = prints URL to log (dev only, blocked in production)
# "demo" = logs URL server-side (safe for public demo without SMTP)
# "smtp" = real email delivery (requires SMTP_* config)
EMAIL_PROVIDER=demo
VERIFICATION_TOKEN_EXPIRE_MINUTES=30
VERIFICATION_RATE_LIMIT=3
FRONTEND_BASE_URL=http://localhost:5173

# ── SMTP (only when EMAIL_PROVIDER=smtp) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@apex-link.local

# ── Login Challenge-Response ──────────────────────────────
CHALLENGE_EXPIRE_SECONDS=120
CHALLENGE_MAX_ATTEMPTS=3

# ── Demo Accounts ─────────────────────────────────────────
# FOR DEMO/DEVELOPMENT ONLY — change for production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
INVESTIGATOR_USERNAME=investigator
INVESTIGATOR_PASSWORD=investigator123
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=analyst123

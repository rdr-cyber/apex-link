# APEX LINK Frontend Environment Variables
# Copy to .env or .env.local for local development.
# For production, set VITE_API_BASE_URL via deployment platform env vars.

# Backend API base URL (including scheme, no trailing slash)
# Development (Vite proxy): leave empty or VITE_API_BASE_URL=
# Production: VITE_API_BASE_URL=https://apex-link-backend.onrender.com
VITE_API_BASE_URL=
